# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA cometa o arquivo ".env" (com credenciais reais) no Git.

# --- Alertas por email (Gmail SMTP) -----------------------------------------
# Gere uma "senha de app" em: https://myaccount.google.com/apppasswords
# (exige verificação em 2 etapas ativada na conta Google)
EMAIL_USUARIO=
EMAIL_SENHA=
GESTOR_EMAIL=

# --- Autenticação ------------------------------------------------------------
# Troque por uma string aleatória longa antes de qualquer uso fora do seu PC
JWT_SECRET_KEY=troque-esta-chave-em-producao
# Senha inicial dos 4 usuários demo (operador/coordenador/gestor/diretor@fabrica.com)
SENHA_PADRAO_DEMO=123456

# --- Parâmetros do cálculo de economia (opcional, tem valores padrão) -------
TEMPO_MANUAL_MIN=45
TEMPO_AUTOMATICO_MIN=3
CUSTO_HORA_PRODUCAO=45.0
CUSTO_MEDIO_RETRABALHO=120.0

# --- Planejamento (opcional, tem valores padrão) ------------------------------
# Expediente da oficina, segunda a sexta. O planejador só conta minutos daqui.
EXPEDIENTE_INICIO_H=7
EXPEDIENTE_FIM_H=17
# Tempo (em minutos de expediente) até uma máquina QUEBRADA voltar, ao planejar nela
FOLGA_MAQUINA_PARADA_MIN=60

# --- Telegram: alertas no grupo (já existente) e bot_telegram.py ------------
# Token do @BotFather. app.py já usa isto para mandar alertas ao grupo
# (nota criada, máquina quebrada/consertada); bot_telegram.py usa o mesmo.
TELEGRAM_TOKEN=
# Grupo que recebe os alertas
TELEGRAM_CHAT_ID=
# Segredo compartilhado só entre app.py e bot_telegram.py. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Troque antes de qualquer uso fora do seu PC — sem isto configurado (vazio),
# /api/telegram/vincular e /api/telegram/token recusam toda chamada.
BOT_SERVICE_TOKEN=
# Backend que o bot chama. Usada SÓ pelo bot; o padrão é o backend local, então
# na apresentação não precisa editar nada. BACKEND_URL (produção) não é usada por ele.
# Só defina para apontar o bot para outro backend (ex.: o do Railway).
BOT_BACKEND_URL=http://127.0.0.1:5000
# Duração do JWT que o bot usa para chamar a API (minutos)
BOT_JWT_EXPIRES_MIN=15
# Código de vínculo: validade e tentativas erradas antes de bloquear
VINCULO_CODIGO_EXPIRA_MIN=10
VINCULO_MAX_TENTATIVAS=5
VINCULO_BLOQUEIO_MIN=15
