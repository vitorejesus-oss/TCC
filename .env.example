# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA cometa o arquivo ".env" (com credenciais reais) no Git.

# --- Alertas por email (Gmail SMTP) -----------------------------------------
# Gere uma "senha de app" em: https://myaccount.google.com/apppasswords
# (exige verificação em 2 etapas ativada na conta Google)
EMAIL_USUARIO=
EMAIL_SENHA=
GESTOR_EMAIL=

# --- Autenticação ------------------------------------------------------------
# Troque por uma string aleatória longa antes de qualquer uso fora do seu PC
JWT_SECRET_KEY=troque-esta-chave-em-producao
# Senha inicial dos 4 usuários demo (operador/coordenador/gestor/diretor@fabrica.com)
SENHA_PADRAO_DEMO=123456

# --- Parâmetros do cálculo de economia (opcional, tem valores padrão) -------
TEMPO_MANUAL_MIN=45
TEMPO_AUTOMATICO_MIN=3
CUSTO_HORA_PRODUCAO=45.0
CUSTO_MEDIO_RETRABALHO=120.0

# --- Planejamento (opcional, tem valores padrão) ------------------------------
# Expediente da oficina, segunda a sexta. O planejador só conta minutos daqui.
EXPEDIENTE_INICIO_H=7
EXPEDIENTE_FIM_H=17
# Tempo (em minutos de expediente) até uma máquina QUEBRADA voltar, ao planejar nela
FOLGA_MAQUINA_PARADA_MIN=60
