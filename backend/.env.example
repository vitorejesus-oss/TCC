# Porta em que o servidor vai rodar
PORT=3000

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório e secreto)
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-grande

# Tempo de expiração do token de login
JWT_EXPIRES_IN=7d

# Código de convite exigido para criar a primeira conta de administrador
# (depois do primeiro admin criado, novos usuários podem ser cadastrados por um admin)
ADMIN_SETUP_CODE=troque-este-codigo

# Intervalo (ms) entre checagens automáticas de status para gerar alertas
MONITOR_INTERVAL_MS=15000

# Limites que disparam alertas automáticos (%)
CPU_ALERT_THRESHOLD=90
MEM_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=90
